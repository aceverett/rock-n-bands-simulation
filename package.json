{
  "name": "rock-n-bands-simulation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "package:scorm": "pnpm run build && node scripts/package-scorm.mjs && node scripts/validate-scorm.mjs",
    "package:scorm:only": "node scripts/package-scorm.mjs && node scripts/validate-scorm.mjs",
    "verify": "npm run test && npm run build && npm run package:scorm && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
